rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/connection {
      allow read: if true;
    }

    match /partners/{partnerId} {
      allow read, write: if true;
    }

    match /events/{eventId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
